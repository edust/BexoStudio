{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bexo Studio",
  "version": "0.1.15",
  "identifier": "studio.bexo.desktop",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bexo Studio",
        "width": 1560,
        "height": 980,
        "minWidth": 1280,
        "minHeight": 760,
        "resizable": true,
        "decorations": true,
        "fullscreen": false,
        "visible": false
      },
      {
        "label": "screenshot_overlay",
        "title": "",
        "url": "index.html?overlay=screenshot",
        "x": 0,
        "y": 0,
        "width": 1280,
        "height": 720,
        "minWidth": 640,
        "minHeight": 360,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "fullscreen": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "base-uri": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "frame-ancestors": "'none'",
        "img-src": "'self' asset: http://asset.localhost bexo-preview: http://bexo-preview.localhost blob: data:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self' customprotocol: asset:",
        "base-uri": "'self'",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420",
        "font-src": "'self' data:",
        "frame-ancestors": "'none'",
        "img-src": "'self' asset: http://asset.localhost bexo-preview: http://bexo-preview.localhost blob: data:",
        "object-src": "'none'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
